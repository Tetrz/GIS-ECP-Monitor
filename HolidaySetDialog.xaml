<Window x:Class="GIS_ECP_Monitor.HolidaySetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GIS_ECP_Monitor"
        mc:Ignorable="d"
        Title="Задать праздничные дни"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow" Height="250" Width="400">
    
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Задать праздничные дни:" FontSize="14"/>
            <TextBox x:Name="HolidaysTextBox"  Height="45" Width="300" AcceptsReturn="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="14"/>
            <TextBlock Width="300" Height="75" Margin="0,5,0,0" TextWrapping="Wrap" Text="Введите даты в формате ДД.ММ.ГГГГ, разделяя их запятыми. Например: 01.01.2024, 07.01.2024" FontSize="14"/>
            <Button Content="OK" Width="75" Margin="0,10,0,0" Click="Ok_Click" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
